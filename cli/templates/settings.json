{
  "cleanupPeriodDays": 30,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rdlc-prompt-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/slop-scan-pretool.sh"
          },
          {
            "type": "command",
            "if": "Write(research/**) Edit(research/**) MultiEdit(research/**) Write(evidence/**) Edit(evidence/**) MultiEdit(evidence/**)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confidence-required.sh"
          },
          {
            "type": "command",
            "if": "Write(research/**) Edit(research/**) MultiEdit(research/**) Write(evidence/**) Edit(evidence/**) MultiEdit(evidence/**)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/source-required.sh"
          },
          {
            "type": "command",
            "if": "Write(output/**) Edit(output/**) MultiEdit(output/**)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audience-firewall.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rdlc-instructions-check.sh"
          }
        ]
      }
    ]
  }
}
