    "CHANGELOG.md",
    "AI_SETUP_LANES.md"
  ],
  "keywords": [
    "claude-code",
    "rdlc",
    "research",
    "ai-agent",
    "developer-tools",
    "research-quality",
    "fact-checking",
    "cross-model-review"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaseInfinity/claude-rdlc-wizard.git"
  },
  "bugs": {
    "url": "https://github.com/BaseInfinity/claude-rdlc-wizard/issues"
  },
  "homepage": "https://github.com/BaseInfinity/claude-rdlc-wizard#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "bash -c 'rc=0; for t in tests/test-*.sh; do echo \"=== $t ===\"; bash \"$t\" || rc=1; done; exit $rc'"
  }
